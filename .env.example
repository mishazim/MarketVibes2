# Copy to .env and fill in. Do NOT commit your real .env.

# Where to email the brief (required only if you want email delivery).
BRIEF_EMAIL_TO=you@example.com

# Reddit (social-tier headlines). Reddit blocks anonymous scraping, so create a
# free "script" app at reddit.com/prefs/apps (2 minutes, no payment) and paste
# its id/secret here. If left blank, the social tier is skipped gracefully and
# the brief runs on the legacy + macro tiers only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Only needed if Ollama isn't running on its default local port/model.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
